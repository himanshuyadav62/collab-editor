  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@collab-editor/editor": ["packages/editor/src/index.ts"],
      "@collab-editor/collab": ["packages/collab/src/index.ts"],
      "@collab-editor/ui": ["packages/ui/src/index.ts"]
    }
  }
}
